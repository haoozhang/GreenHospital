    {
      "id": "CWE-259",
      "title": "Use of Hard-coded Password",
      "category": "Credentials & Secrets",
      "severity": "optional",
      "description": "The product contains a hard-coded password, which it uses for its own inbound authentication or for outbound communication to external components.",
      "evidence": {
        "files": [
          "Migrations/Configuration.cs"
        ],
        "explanation": "In Migrations/Configuration.cs, line 51, the seed method hard-codes the admin user password: idManager.CreateUser(newUser, \"12345678\"). This default admin credential is embedded directly in source code and will be seeded into the database on initialization."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-778",
      "title": "Insufficient Logging",
      "category": "Credentials & Secrets",
      "severity": "potential",
      "description": "When a security-critical event occurs, the product either does not record the event or omits important details about the event when logging it.",
      "evidence": {
        "files": [
          "Controllers/AccountController.cs"
        ],
        "explanation": "No logging framework (ILogger, NLog, log4net, Serilog, EventLog, etc.) is used anywhere in the application. Security-critical events such as failed login attempts (AccountController.cs line 56: \"Invalid username or password.\") and authentication failures are handled via ModelState errors only, with no logging to any audit trail or log sink."
      },
      "storyPoint": 3
    },
    {
      "id": "CWE-798",
      "title": "Use of Hard-coded Credentials",
      "category": "Credentials & Secrets",
      "severity": "optional",
      "description": "The product contains hard-coded credentials, such as a password or cryptographic key.",
      "evidence": {
        "files": [
          "Migrations/Configuration.cs"
        ],
        "explanation": "In Migrations/Configuration.cs, line 51, the seed method embeds the admin username (\"Admin\") and password (\"12345678\") as hard-coded credentials: idManager.CreateUser(newUser, \"12345678\"). These credentials are committed to source control and seeded into the database on startup."
      },
      "storyPoint": 5
    },
    {
      "id": "CWE-772",
      "title": "Missing Release of Resource after Effective Lifetime",
      "category": "Code Quality",
      "severity": "potential",
      "description": "The product does not release a resource after its effective lifetime has ended, i.e., after the resource is no longer needed.",
      "evidence": {
        "files": [
          "Models/BuisnessLogic.cs"
        ],
        "explanation": "In BuisnessLogic.cs, HospitalDbContext instances are created locally (e.g., lines 16, 29, 41, 62) without a using statement or explicit Dispose() call. The DbContext (which holds database connections) is never released, causing resource leaks."
      },
      "storyPoint": 3
    },
    {
      "id": "CWE-1057",
      "title": "Data Access Operations Outside of Expected Data Manager Component",
      "category": "Code Quality",
      "severity": "potential",
      "description": "The product uses a dedicated, central data manager component as required by design, but it contains code that performs data-access operations that do not use this data manager.",
      "evidence": {
        "files": [
          "Models/BuisnessLogic.cs"
        ],
        "explanation": "BuisnessLogic.cs (a business logic class) directly instantiates HospitalDbContext (lines 16, 29, 41, 62) to perform database operations, bypassing the controller-managed DbContext lifecycle. Data access in the business logic layer is performed outside the expected data manager (controller-level DbContext) component."
      },
      "storyPoint": 5
    }
  ]
